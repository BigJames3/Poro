# Poro — variables partagées du poste de développement.
# Chaque service a son propre modèle (ex. services/auth/.env.example).
# Ne jamais committer de vraie valeur : .env est ignoré par Git.

# PostgreSQL (docker-compose, port hôte 5433)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=poro
POSTGRES_PASSWORD=poro_dev_password

# Redis (docker-compose, port hôte 6380)
REDIS_HOST=localhost
REDIS_PORT=6380

# Kafka / Redpanda
KAFKA_BROKERS=localhost:9092

# Stockage objet S3 (SeaweedFS en local, Backblaze B2 en production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# CDN (Bunny)
BUNNY_API_KEY=
BUNNY_PULL_ZONE=
