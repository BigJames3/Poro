# =============================================================================
# Poro — variables d'environnement de DÉVELOPPEMENT (modèle)
# Copier en .env (ignoré par Git) puis renseigner chaque valeur vide.
# Générer les secrets avec : openssl rand -hex 32  (aucun caractère à échapper)
# Ne jamais committer de valeur réelle.
# =============================================================================

# Environnement : dev | staging | prod
APP_ENV=dev
LOG_LEVEL=debug

# --- PostgreSQL (hôte : 127.0.0.1:5433) ----------------------------------------
POSTGRES_USER=poro
# Volume existant : le mot de passe est fixé à sa création. Si votre volume
# poro_postgres_data existe déjà, reprenez l'ancien mot de passe ici.
POSTGRES_PASSWORD=
POSTGRES_DB=poro_auth

# --- Redis (hôte : 127.0.0.1:6380, mot de passe obligatoire) -------------------
REDIS_PASSWORD=

# --- ClickHouse / Qdrant -----------------------------------------------------------
CLICKHOUSE_USER=poro
CLICKHOUSE_PASSWORD=
QDRANT_API_KEY=

# --- OTP (fournisseur SMS) -------------------------------------------------------
OTP_PROVIDER_URL=
OTP_PROVIDER_KEY=

# --- Stockage / CDN / Paiement (services à venir) ---------------------------------
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
BUNNY_API_KEY=
BUNNY_PULL_ZONE=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
FLUTTERWAVE_SECRET_KEY=
