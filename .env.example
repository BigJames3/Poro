# Poro — variables partagées du poste de développement.
# Copier vers .env (ignoré par Git) : Copy-Item .env.example .env
# Ne jamais committer de vraie valeur de production.
#
# Docker Compose lit automatiquement le .env du même dossier pour interpoler
# docker-compose.yml. Les services ne reçoivent PAS tout le fichier : chaque
# secret est passé via un bloc environment: explicite.
#
# Compose exige ces 4 variables (échec immédiat si absentes) :
#   POSTGRES_PASSWORD, CLICKHOUSE_PASSWORD, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
#
# Placeholders locaux uniquement — pas des secrets de production.
# Garder POSTGRES_PASSWORD=poro_dev_password : le volume Postgres existant
# a été initialisé avec ce mot de passe.
# POSTGRES_PASSWORD must be URL-safe (no @ : / #) because Compose interpolates
# it into DATABASE_URL (postgresql://poro:${POSTGRES_PASSWORD}@...).

# PostgreSQL (docker-compose, port hôte 5433)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=poro
POSTGRES_PASSWORD=poro_dev_password

# ClickHouse (docker compose --profile analytics)
CLICKHOUSE_PASSWORD=poro_dev_password

# Redis (docker-compose, port hôte 6380)
REDIS_HOST=localhost
REDIS_PORT=6380

# SMS OTP du service auth (log = codes dans les logs, africastalking = envoi réel)
# Pour tester sans envoi réel : SMS_PROVIDER=africastalking, AFRICASTALKING_USERNAME=sandbox
SMS_PROVIDER=log
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Kafka / Redpanda
KAFKA_BROKERS=localhost:9092

# Stockage objet S3 (SeaweedFS en local, Backblaze B2 en production)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=poro_dev
S3_SECRET_ACCESS_KEY=poro_dev_secret
S3_BUCKET=poro-avatars

# CDN (Bunny)
BUNNY_API_KEY=
BUNNY_PULL_ZONE=

# Push FCM du service notification : JSON du compte de service Firebase,
# encodé en base64 sur une ligne. Vide = push désactivé, notifications in-app seules.
FCM_CREDENTIALS_B64=
