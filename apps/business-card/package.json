{
  "name": "@poro/business-card",
  "version": "1.0.0",
  "private": true,
  "description": "Carte de visite numérique : page statique, vCard, QR code, PWA hors ligne",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.0",
    "eslint": "9.38.0",
    "globals": "16.4.0",
    "jsqr": "1.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
