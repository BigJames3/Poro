{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.payment.payment.succeeded.v1.json",
  "title": "poro.payment.payment.succeeded v1",
  "description": "Published by payment once the provider confirmed the payment by a verified webhook or a server-side status check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "source", "subject", "occurred_at", "data"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "poro.payment.payment.succeeded" },
    "version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "format": "uuid", "description": "payment id" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payment_id", "order_id", "buyer_id", "amount", "currency", "provider", "succeeded_at"],
      "properties": {
        "payment_id": { "type": "string", "format": "uuid" },
        "order_id": { "type": "string", "format": "uuid" },
        "buyer_id": { "type": "string", "format": "uuid" },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000,
          "description": "minor units: XOF and XAF have none, NGN is in kobo"
        },
        "currency": { "enum": ["XOF", "XAF", "NGN"], "description": "XOF for CI and SN, XAF for CM, NGN for NG" },
        "provider": { "enum": ["wave", "simulated"] },
        "succeeded_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
