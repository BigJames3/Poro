{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.video.deleted.v1.json",
  "title": "poro.video.deleted v1",
  "description": "Published by the video API when the owner soft-deletes a video, whatever its status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "version",
    "source",
    "subject",
    "occurred_at",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "poro.video.deleted"
    },
    "version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "format": "uuid",
      "description": "video id"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video_id",
        "user_id",
        "deleted_at"
      ],
      "properties": {
        "video_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "deleted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
