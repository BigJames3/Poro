{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.order.order.cancelled.v1.json",
  "title": "poro.order.order.cancelled v1",
  "description": "Published by order when an order ends before completion. Shop releases the stock it holds and payment refunds when paid is true.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "source", "subject", "occurred_at", "data"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "poro.order.order.cancelled" },
    "version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "format": "uuid", "description": "order id" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "buyer_id", "shop_id", "seller_id", "reason", "paid", "cancelled_at"],
      "properties": {
        "order_id": { "type": "string", "format": "uuid" },
        "buyer_id": { "type": "string", "format": "uuid" },
        "shop_id": { "type": "string", "format": "uuid" },
        "seller_id": { "type": "string", "format": "uuid" },
        "reason": { "enum": ["stock_rejected", "payment_timeout", "buyer_cancelled", "seller_cancelled"] },
        "paid": { "type": "boolean" },
        "cancelled_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
