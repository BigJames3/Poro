{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.auth.user.deletion_cancelled.v1.json",
  "title": "poro.auth.user.deletion_cancelled v1",
  "description": "Published by auth when a scheduled deletion is cancelled, explicitly or by signing in again. Every service shows the account again. changed_at orders it against poro.auth.user.deletion_scheduled: keep the latest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "version",
    "source",
    "subject",
    "occurred_at",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "poro.auth.user.deletion_cancelled"
    },
    "version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "format": "uuid",
      "description": "auth account id"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "changed_at"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "changed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
