{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.order.order.created.v1.json",
  "title": "poro.order.order.created v1",
  "description": "Published by order at checkout, one order per shop. Shop answers with stock.reserved or stock.rejected. Prices are the ones the buyer saw.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "source", "subject", "occurred_at", "data"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "poro.order.order.created" },
    "version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "format": "uuid", "description": "order id" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "buyer_id", "shop_id", "seller_id", "currency", "payment_method", "items", "created_at"],
      "properties": {
        "order_id": { "type": "string", "format": "uuid" },
        "buyer_id": { "type": "string", "format": "uuid" },
        "shop_id": { "type": "string", "format": "uuid" },
        "seller_id": { "type": "string", "format": "uuid" },
        "currency": { "enum": ["XOF", "XAF", "NGN"], "description": "XOF for CI and SN, XAF for CM, NGN for NG" },
        "payment_method": {
          "enum": ["cash_on_delivery", "wave", "simulated"],
          "description": "simulated is refused outside dev"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product_id", "variant_id", "quantity", "unit_price"],
            "properties": {
              "product_id": { "type": "string", "format": "uuid" },
              "variant_id": { "type": "string", "format": "uuid" },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 99 },
              "unit_price": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000,
                "description": "minor units: XOF and XAF have none, NGN is in kobo"
              }
            }
          }
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
