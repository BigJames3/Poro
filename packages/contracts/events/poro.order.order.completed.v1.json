{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.order.order.completed.v1.json",
  "title": "poro.order.order.completed v1",
  "description": "Published by order when the buyer confirms receipt or the confirmation delay ends. The amount becomes payable to the seller.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "source", "subject", "occurred_at", "data"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "poro.order.order.completed" },
    "version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "format": "uuid", "description": "order id" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "buyer_id", "shop_id", "seller_id", "currency", "total", "payment_method", "completed_at"],
      "properties": {
        "order_id": { "type": "string", "format": "uuid" },
        "buyer_id": { "type": "string", "format": "uuid" },
        "shop_id": { "type": "string", "format": "uuid" },
        "seller_id": { "type": "string", "format": "uuid" },
        "currency": { "enum": ["XOF", "XAF", "NGN"], "description": "XOF for CI and SN, XAF for CM, NGN for NG" },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000,
          "description": "minor units: XOF and XAF have none, NGN is in kobo"
        },
        "payment_method": {
          "enum": ["cash_on_delivery", "wave", "simulated"],
          "description": "simulated is refused outside dev"
        },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
