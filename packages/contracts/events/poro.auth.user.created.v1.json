{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.auth.user.created.v1.json",
  "title": "poro.auth.user.created v1",
  "description": "Published by auth when an account is created. Carries no phone number or email.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "source", "subject", "occurred_at", "data"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "poro.auth.user.created" },
    "version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "format": "uuid", "description": "auth account id" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "signup_method", "country_code", "language", "created_at"],
      "properties": {
        "user_id": { "type": "string", "format": "uuid" },
        "signup_method": { "type": "string", "enum": ["phone", "email"] },
        "country_code": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "language": { "type": "string", "minLength": 2, "maxLength": 8 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
