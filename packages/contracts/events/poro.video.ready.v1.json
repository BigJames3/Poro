{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.video.ready.v1.json",
  "title": "poro.video.ready v1",
  "description": "Published by the media-worker when HLS renditions and a thumbnail are stored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "source", "subject", "occurred_at", "data"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "poro.video.ready" },
    "version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "format": "uuid", "description": "video id" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_id", "user_id", "duration_ms", "width", "height", "hls_key", "thumbnail_key", "renditions", "ready_at"],
      "properties": {
        "video_id": { "type": "string", "format": "uuid" },
        "user_id": { "type": "string", "format": "uuid" },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "hls_key": { "type": "string", "minLength": 1 },
        "thumbnail_key": { "type": "string", "minLength": 1 },
        "renditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "bandwidth", "width", "height", "playlist_key"],
            "properties": {
              "name": { "type": "string" },
              "bandwidth": { "type": "integer", "minimum": 1 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "playlist_key": { "type": "string", "minLength": 1 }
            }
          }
        },
        "ready_at": { "type": "string", "format": "date-time" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Added after release: absent on older events." },
        "description": { "type": "string", "maxLength": 500, "description": "Added after release: absent on older events." },
        "hashtags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[\\p{L}\\p{N}_]{1,50}$" },
          "description": "Lower-cased tags parsed from the description, without '#'. Added after release."
        },
        "published_at": { "type": "string", "format": "date-time", "description": "When the video became visible. Added after release." }
      }
    }
  }
}
