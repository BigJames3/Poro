{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.user.creator.activated.v1.json",
  "title": "poro.user.creator.activated v1",
  "description": "Published by the user service when a profile becomes a creator. Auth grants CREATOR.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "source", "subject", "occurred_at", "data"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "poro.user.creator.activated" },
    "version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "format": "uuid", "description": "auth account id" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "username", "activated_at"],
      "properties": {
        "user_id": { "type": "string", "format": "uuid" },
        "username": { "type": "string", "pattern": "^[a-z0-9._]{3,30}$" },
        "activated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
