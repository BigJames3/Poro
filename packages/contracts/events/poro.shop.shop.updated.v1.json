{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.shop.shop.updated.v1.json",
  "title": "poro.shop.shop.updated v1",
  "description": "Full snapshot of a shop after any change. Keep the latest updated_at.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "source", "subject", "occurred_at", "data"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "poro.shop.shop.updated" },
    "version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "format": "uuid", "description": "shop id" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shop_id",
        "owner_id",
        "name",
        "handle",
        "description",
        "logo_url",
        "country_code",
        "currency",
        "status",
        "updated_at"
      ],
      "properties": {
        "shop_id": { "type": "string", "format": "uuid" },
        "owner_id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "handle": { "type": "string", "pattern": "^[a-z0-9._]{3,30}$" },
        "description": { "type": ["string", "null"], "maxLength": 500 },
        "logo_url": { "type": ["string", "null"], "format": "uri" },
        "country_code": { "enum": ["CI", "SN", "CM", "NG"] },
        "currency": { "enum": ["XOF", "XAF", "NGN"], "description": "XOF for CI and SN, XAF for CM, NGN for NG" },
        "status": { "enum": ["active", "suspended", "closed"] },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
