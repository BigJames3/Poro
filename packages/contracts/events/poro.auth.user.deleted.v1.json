{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.auth.user.deleted.v1.json",
  "title": "poro.auth.user.deleted v1",
  "description": "Published by auth when an account is erased, 30 days after its owner asked for it. Every consumer forgets or anonymizes the data it holds about the account. Carries no phone number or email.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "source", "subject", "occurred_at", "data"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "poro.auth.user.deleted" },
    "version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "format": "uuid", "description": "auth account id" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "deleted_at"],
      "properties": {
        "user_id": { "type": "string", "format": "uuid" },
        "deleted_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
