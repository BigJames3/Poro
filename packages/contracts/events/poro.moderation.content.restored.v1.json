{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.moderation.content.restored.v1.json",
  "title": "poro.moderation.content.restored v1",
  "description": "Published by moderation when a moderator restores a removed video. Removed comments cannot be restored in v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "version",
    "source",
    "subject",
    "occurred_at",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "poro.moderation.content.restored"
    },
    "version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "format": "uuid",
      "description": "target id (video)"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "target_type",
        "target_id",
        "owner_id",
        "restored_at"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_type": {
          "type": "string",
          "enum": [
            "video"
          ]
        },
        "target_id": {
          "type": "string",
          "format": "uuid"
        },
        "owner_id": {
          "type": "string",
          "format": "uuid"
        },
        "restored_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
