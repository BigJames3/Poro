{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poro.africa/events/poro.auth.user.deletion_scheduled.v1.json",
  "title": "poro.auth.user.deletion_scheduled v1",
  "description": "Published by auth when the owner of an account asks to delete it. Until erase_at, every service hides the account's profile and content but keeps the data, so that a cancellation restores it. changed_at orders this event against poro.auth.user.deletion_cancelled, which travels on another topic: keep the latest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "version",
    "source",
    "subject",
    "occurred_at",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "poro.auth.user.deletion_scheduled"
    },
    "version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "format": "uuid",
      "description": "auth account id"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "erase_at",
        "changed_at"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "erase_at": {
          "type": "string",
          "format": "date-time"
        },
        "changed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
