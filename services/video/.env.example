# Video service (Go). Copy to .env — never commit real values.

APP_ENV=dev
APP_PORT=8083
LOG_LEVEL=debug

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=poro
POSTGRES_PASSWORD=poro_dev_password
POSTGRES_DB=poro_video
POSTGRES_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=2

JWKS_URL=http://localhost:8081/.well-known/jwks.json
KAFKA_BROKERS=localhost:9092

# Server-to-server object storage. Presigned part URLs use S3_PUBLIC_ENDPOINT.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=poro-videos
S3_ACCESS_KEY_ID=poro_dev
S3_SECRET_ACCESS_KEY=poro_dev_secret
S3_FORCE_PATH_STYLE=true

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

TRUSTED_PROXIES=
OTEL_EXPORTER_OTLP_ENDPOINT=
