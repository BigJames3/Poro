# syntax=docker/dockerfile:1
# Build context: repository root (needs packages/shared-go).

FROM golang:1.26-alpine AS builder

WORKDIR /src
COPY packages/shared-go /src/packages/shared-go
COPY services/video/go.mod services/video/go.sum /src/services/video/
WORKDIR /src/services/video
RUN go mod download

COPY services/video /src/services/video
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/media-worker ./cmd/worker

FROM alpine:3.22

RUN apk add --no-cache ca-certificates ffmpeg && adduser -D -u 10001 app

WORKDIR /app
COPY --from=builder /out/media-worker /app/media-worker
COPY services/video/migrations /app/migrations

ENV MIGRATIONS_PATH=/app/migrations

USER app

ENTRYPOINT ["/app/media-worker"]
