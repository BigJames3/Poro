// PORO shop service database (poro_shop).
// Migrations are written by hand and checked with `prisma migrate diff`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// One shop per auth account: owner_id is the auth account ID (JWT sub) of the
// account that opened it. There is no separate shop login.
model Shop {
  id          String    @id @db.Uuid
  ownerId     String    @unique @map("owner_id") @db.Uuid
  name        String    @db.VarChar(60)
  // Lowercase; unique even across closed shops so a handle is never reused.
  handle      String    @unique @db.VarChar(30)
  description String?   @db.VarChar(500)
  logoKey     String?   @map("logo_key") @db.VarChar(200)
  // Fixed at opening: the country sets the currency of every price.
  countryCode String    @map("country_code") @db.Char(2)
  currency    String    @db.Char(3)
  status      String    @default("active") @db.VarChar(16)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    Product[]

  @@map("shops")
}

model Product {
  id          String         @id @db.Uuid
  shopId      String         @map("shop_id") @db.Uuid
  title       String         @db.VarChar(120)
  description String?        @db.VarChar(2000)
  status      String         @default("draft") @db.VarChar(16)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)
  shop        Shop           @relation(fields: [shopId], references: [id])
  images      ProductImage[]
  variants    Variant[]

  @@index([shopId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("products")
}

model ProductImage {
  id        String   @id @db.Uuid
  productId String   @map("product_id") @db.Uuid
  key       String   @db.VarChar(200)
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId, position])
  @@map("product_images")
}

// A purchasable variant. Available stock is stock_on_hand - stock_reserved;
// orders reference variant ids, so a removed variant is soft-deleted.
model Variant {
  id            String    @id @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  title         String    @db.VarChar(60)
  // Minor units of the shop currency.
  price         BigInt
  stockOnHand   Int       @default(0) @map("stock_on_hand")
  stockReserved Int       @default(0) @map("stock_reserved")
  position      Int
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  product       Product   @relation(fields: [productId], references: [id])

  @@index([productId, position])
  @@map("variants")
}

// The answer to one order: stock held, released, consumed, rejected, or
// cancelled before the order reached this service. One row per order.
model Reservation {
  orderId   String   @id @map("order_id") @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  status    String   @db.VarChar(16)
  currency  String?  @db.Char(3)
  subtotal  BigInt?
  // [{product_id, variant_id, quantity, unit_price, title}]
  lines     Json     @default("[]")
  reason    String?  @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([shopId, createdAt])
  @@map("reservations")
}

// Transactional outbox relayed by services/outbox-relay. The relay owns the
// column set (github.com/poro/shared-go/outbox.Schema), so there is no updated_at.
model OutboxEvent {
  id          String    @id @db.Uuid
  topic       String    @db.VarChar(200)
  eventKey    String    @map("event_key") @db.VarChar(200)
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, createdAt, id])
  @@map("outbox_events")
}

// Consumer idempotency: one row per (consumer group, event) already applied.
model ProcessedEvent {
  consumer    String   @db.VarChar(100)
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("processed_events")
}
