# Local development of one outbox relay against the Compose infrastructure.
# The relay reads the process environment only (no .env file): export these
# variables before `go run ./cmd/relay`. Never commit a production value.

# Required, no default: dev, staging or prod.
APP_ENV=dev
LOG_LEVEL=info
HTTP_PORT=9100

# The service database whose outbox this relay publishes.
RELAY_SOURCE=auth
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=poro
POSTGRES_PASSWORD=poro_dev_password
POSTGRES_DB=poro_auth
POSTGRES_SSLMODE=disable

KAFKA_BROKERS=localhost:9092
RELAY_BATCH_SIZE=100
RELAY_POLL_INTERVAL=500ms
RELAY_RETENTION=72h
