// PORO order service database (poro_order).
// Migrations are written by hand and checked with `prisma migrate diff`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// Projection of poro.shop.shop.updated: the latest snapshot of each shop.
model CatalogShop {
  id              String   @id @db.Uuid
  ownerId         String   @map("owner_id") @db.Uuid
  name            String   @db.VarChar(60)
  handle          String   @db.VarChar(30)
  currency        String   @db.Char(3)
  status          String   @db.VarChar(16)
  sourceUpdatedAt DateTime @map("source_updated_at") @db.Timestamptz(6)

  @@map("catalog_shops")
}

// Projection of poro.shop.product.updated and .deleted.
model CatalogProduct {
  id              String           @id @db.Uuid
  shopId          String           @map("shop_id") @db.Uuid
  title           String           @db.VarChar(120)
  currency        String           @db.Char(3)
  status          String           @db.VarChar(16)
  imageUrl        String?          @map("image_url") @db.VarChar(500)
  sourceUpdatedAt DateTime         @map("source_updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)
  variants        CatalogVariant[]

  @@index([shopId])
  @@map("catalog_products")
}

// Variants of the latest product snapshot. A variant missing from it is
// marked removed so carts can tell it is gone.
model CatalogVariant {
  id        String         @id @db.Uuid
  productId String         @map("product_id") @db.Uuid
  title     String         @db.VarChar(60)
  price     BigInt
  inStock   Boolean        @map("in_stock")
  removed   Boolean        @default(false)
  product   CatalogProduct @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("catalog_variants")
}

// One cart per account (JWT sub), one row per variant.
model CartItem {
  buyerId   String   @map("buyer_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([buyerId, variantId])
  @@map("cart_items")
}

// A checkout replayed with the same Idempotency-Key returns the same orders.
model Checkout {
  id             String   @id @db.Uuid
  buyerId        String   @map("buyer_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(100)
  requestHash    String   @map("request_hash") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  orders         Order[]

  @@unique([buyerId, idempotencyKey])
  @@map("checkouts")
}

// One order per shop of a checkout. Amounts are minor units of currency.
model Order {
  id                String      @id @db.Uuid
  checkoutId        String      @map("checkout_id") @db.Uuid
  buyerId           String      @map("buyer_id") @db.Uuid
  shopId            String      @map("shop_id") @db.Uuid
  // Copied at checkout: the order keeps the name the buyer saw.
  shopName          String      @map("shop_name") @db.VarChar(60)
  sellerId          String      @map("seller_id") @db.Uuid
  currency          String      @db.Char(3)
  paymentMethod     String      @map("payment_method") @db.VarChar(32)
  status            String      @db.VarChar(20)
  subtotalSeen      BigInt      @map("subtotal_seen")
  // Set by stock.reserved: the amount the buyer pays.
  total             BigInt?
  // Delivery contact: visible to the buyer and the seller only, erased
  // CONTACT_RETENTION_DAYS after the order ends.
  contactName       String?     @map("contact_name") @db.VarChar(80)
  contactPhone      String?     @map("contact_phone") @db.VarChar(16)
  city              String?     @db.VarChar(80)
  address           String?     @db.VarChar(300)
  // Directions to find the place: landmark, gate colour… Optional.
  landmark          String?     @db.VarChar(300)
  // GPS position shared by the buyer, if they allowed it.
  latitude          Float?
  longitude         Float?
  locationAccuracyM Int?        @map("location_accuracy_m")
  contactErasedAt   DateTime?   @map("contact_erased_at") @db.Timestamptz(6)
  tracking          String?     @db.VarChar(200)
  cancelReason      String?     @map("cancel_reason") @db.VarChar(32)
  paid              Boolean     @default(false)
  lastPaymentError  String?     @map("last_payment_error") @db.VarChar(32)
  expiresAt         DateTime?   @map("expires_at") @db.Timestamptz(6)
  placedAt          DateTime?   @map("placed_at") @db.Timestamptz(6)
  paidAt            DateTime?   @map("paid_at") @db.Timestamptz(6)
  shippedAt         DateTime?   @map("shipped_at") @db.Timestamptz(6)
  completedAt       DateTime?   @map("completed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  refundedAt        DateTime?   @map("refunded_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  checkout          Checkout    @relation(fields: [checkoutId], references: [id])
  lines             OrderLine[]

  @@index([buyerId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, expiresAt])
  @@index([status, shippedAt])
  @@map("orders")
}

model OrderLine {
  orderId       String  @map("order_id") @db.Uuid
  position      Int
  productId     String  @map("product_id") @db.Uuid
  variantId     String  @map("variant_id") @db.Uuid
  title         String  @db.VarChar(200)
  quantity      Int
  // The price the buyer saw in the cart.
  unitPriceSeen BigInt  @map("unit_price_seen")
  // The authoritative price from stock.reserved.
  unitPrice     BigInt? @map("unit_price")
  order         Order   @relation(fields: [orderId], references: [id])

  @@id([orderId, position])
  @@map("order_lines")
}

// Delivery address book of an account. At most one default per account.
model Address {
  id                String   @id @db.Uuid
  buyerId           String   @map("buyer_id") @db.Uuid
  label             String?  @db.VarChar(40)
  fullName          String   @map("full_name") @db.VarChar(80)
  phone             String   @db.VarChar(16)
  city              String   @db.VarChar(80)
  address           String?  @db.VarChar(300)
  landmark          String?  @db.VarChar(300)
  latitude          Float?
  longitude         Float?
  locationAccuracyM Int?     @map("location_accuracy_m")
  isDefault         Boolean  @default(false) @map("is_default")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([buyerId, createdAt])
  @@map("addresses")
}

// The recap shown before the buyer confirms. Orders are only created from a
// preview, and only while the cart still matches it.
model CheckoutPreview {
  id          String    @id @db.Uuid
  buyerId     String    @map("buyer_id") @db.Uuid
  cartHash    String    @map("cart_hash") @db.Char(64)
  // The delivery details and options the buyer reviewed.
  request     Json
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  checkoutId  String?   @map("checkout_id") @db.Uuid
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([buyerId, createdAt])
  @@index([expiresAt])
  @@map("checkout_previews")
}

// Transactional outbox relayed by services/outbox-relay. The relay owns the
// column set (github.com/poro/shared-go/outbox.Schema), so there is no updated_at.
model OutboxEvent {
  id          String    @id @db.Uuid
  topic       String    @db.VarChar(200)
  eventKey    String    @map("event_key") @db.VarChar(200)
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, createdAt, id])
  @@map("outbox_events")
}

// Consumer idempotency: one row per (consumer group, event) already applied.
model ProcessedEvent {
  consumer    String   @db.VarChar(100)
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("processed_events")
}
