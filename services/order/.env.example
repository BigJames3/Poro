# Order service (NestJS). Copy to .env — never commit real values.

APP_ENV=dev
PORT=8091
LOG_LEVEL=debug

# Host port 5433 maps to the compose Postgres.
DATABASE_URL=postgresql://poro:poro_dev_password@localhost:5433/poro_order?sslmode=disable

# Optional in dev (in-memory rate limits). Required outside dev.
REDIS_URL=redis://localhost:6380/9

JWKS_URL=http://localhost:8081/.well-known/jwks.json
KAFKA_BROKERS=localhost:9092
# false: HTTP only, used by some tests
KAFKA_CONSUMER_ENABLED=true

# Payment methods offered at checkout: cash_on_delivery, wave, simulated (dev only).
# Wave stays off until the payment service exists.
PAYMENT_METHODS=cash_on_delivery
# Unpaid orders are cancelled after this many minutes.
PAYMENT_TIMEOUT_MINUTES=30
# Shipped orders complete on their own after this many days.
AUTO_COMPLETE_DAYS=7
# Delivery contacts of finished orders are erased after this many days.
CONTACT_RETENTION_DAYS=90
# false: no timed transitions (used by some tests)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

# Exact origins only. Empty disables CORS (same-origin / native apps).
CORS_ORIGINS=
# Express trust proxy: false, a hop count, or a CIDR/IP
TRUST_PROXY=false

# OTLP HTTP base URL; empty disables export
OTEL_EXPORTER_OTLP_ENDPOINT=
