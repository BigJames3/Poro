# Moderation service (Python/FastAPI). Copy to .env — never commit real values.

APP_ENV=dev
PORT=8087
LOG_LEVEL=DEBUG

# Host port 5433 maps to the compose Postgres. sslmode: disable in dev,
# require / verify-ca / verify-full elsewhere.
DATABASE_URL=postgresql://poro:poro_dev_password@localhost:5433/poro_moderation?sslmode=disable

# Optional in dev (in-memory rate limits). Required outside dev.
REDIS_URL=redis://localhost:6380/6

JWKS_URL=http://localhost:8081/.well-known/jwks.json
KAFKA_BROKERS=localhost:9092
# false: HTTP only
KAFKA_CONSUMER_ENABLED=true

# Distinct reporters that raise a case to high priority.
REPORT_THRESHOLD=3
# Word lists of the automatic filter; defaults to the packaged rules/fr.yml.
# RULES_PATH=/etc/poro/moderation/fr.yml
