# Notification service (NestJS). Copy to .env — never commit real values.

APP_ENV=dev
PORT=8086
LOG_LEVEL=debug

# Host port 5433 maps to the compose Postgres.
DATABASE_URL=postgresql://poro:poro_dev_password@localhost:5433/poro_notification?sslmode=disable

# Optional in dev (in-memory rate limits). Required outside dev.
REDIS_URL=redis://localhost:6380/5

JWKS_URL=http://localhost:8081/.well-known/jwks.json
KAFKA_BROKERS=localhost:9092
# false: HTTP only, used by some tests
KAFKA_CONSUMER_ENABLED=true

# Base64 of the Firebase service account JSON, on one line. Empty disables push:
# in-app notifications keep working.
FCM_CREDENTIALS_B64=

# Notifications without activity for this many days are purged daily (7-3650).
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_PURGE_ENABLED=true

# Exact origins only. Empty disables CORS (same-origin / native apps).
CORS_ORIGINS=
# Express trust proxy: false, a hop count, or a CIDR/IP
TRUST_PROXY=false

# OTLP HTTP base URL; empty disables export
OTEL_EXPORTER_OTLP_ENDPOINT=
