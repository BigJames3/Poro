# App
APP_ENV=dev
APP_PORT=8081
LOG_LEVEL=debug

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=poro
POSTGRES_PASSWORD=poro_dev_password
POSTGRES_DB=poro_auth
POSTGRES_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# OTP
OTP_TTL=5m
OTP_MAX_ATTEMPTS=3
OTP_PROVIDER_URL=
OTP_PROVIDER_KEY=
