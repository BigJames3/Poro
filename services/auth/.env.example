# App
APP_ENV=dev
APP_PORT=8081
LOG_LEVEL=debug
# CIDRs or IPs of the reverse proxies allowed to set X-Forwarded-For (comma separated)
TRUSTED_PROXIES=

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=poro
POSTGRES_PASSWORD=poro_dev_password
POSTGRES_DB=poro_auth
POSTGRES_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_REFRESH_REUSE_GRACE=30s

# OTP
OTP_TTL=5m
OTP_MAX_ATTEMPTS=3
# Required outside dev, at least 32 bytes
OTP_HMAC_SECRET=
OTP_REQUEST_COOLDOWN=60s
OTP_MAX_REQUESTS_PER_HOUR=5
# Countries allowed to receive codes (comma separated); empty allows every country
OTP_ALLOWED_CALLING_CODES=+225,+221,+237,+234
# log (dev only, codes are written to the logs) or africastalking
SMS_PROVIDER=log

# Africa's Talking (SMS_PROVIDER=africastalking); username "sandbox" uses the sandbox
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional registered alphanumeric sender ID, e.g. PORO
AFRICASTALKING_SENDER_ID=

# Events (consumer of poro.user.creator.activated). Sign-in works if the broker is down.
KAFKA_BROKERS=localhost:9092

# OTLP HTTP base URL; empty disables export
OTEL_EXPORTER_OTLP_ENDPOINT=
