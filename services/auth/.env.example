# App
APP_ENV=dev
APP_PORT=8081
LOG_LEVEL=debug
# CIDRs or IPs of the reverse proxies allowed to set X-Forwarded-For (comma separated)
TRUSTED_PROXIES=

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=poro
POSTGRES_PASSWORD=poro_dev_password
POSTGRES_DB=poro_auth
POSTGRES_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_REFRESH_REUSE_GRACE=30s

# OTP
OTP_TTL=5m
OTP_MAX_ATTEMPTS=3
# Required outside dev, at least 32 bytes
OTP_HMAC_SECRET=
OTP_REQUEST_COOLDOWN=60s
OTP_MAX_REQUESTS_PER_HOUR=5

# SMS budget against SMS pumping (ADR-0017): caps per phone and UTC day, per
# number range and hour, per calling code and hour, and for the whole platform
# per UTC day (reached, no OTP SMS is sent until the next day).
SMS_DAILY_LIMIT_PER_PHONE=10
SMS_HOURLY_LIMIT_PER_PREFIX=20
SMS_HOURLY_LIMIT_PER_COUNTRY=1000
SMS_DAILY_LIMIT=5000

# Password sign-in lock per account, whatever the IP (ADR-0017).
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=15m
LOGIN_LOCK_BASE=1m
LOGIN_LOCK_MAX=15m
# Countries allowed to receive codes (comma separated); empty allows every country
OTP_ALLOWED_CALLING_CODES=+225,+221,+237,+234
# log (dev only, codes are written to the logs) or africastalking
SMS_PROVIDER=log

# Africa's Talking (SMS_PROVIDER=africastalking); username "sandbox" uses the sandbox
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional registered alphanumeric sender ID, e.g. PORO
AFRICASTALKING_SENDER_ID=

# Email codes (verification, password reset). log = codes in the logs, dev only.
# smtp: any relay (Brevo, SES, ...); TLS is mandatory (465 implicit TLS, otherwise STARTTLS).
EMAIL_PROVIDER=log
EMAIL_FROM=
EMAIL_CODE_TTL=15m
EMAIL_CODE_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Secret: provide it through the secret manager, never commit it.
SMTP_PASSWORD=

# Account deletion: erased this long after the request unless the owner signs in again;
# due accounts are erased every ACCOUNT_PURGE_INTERVAL on each replica (SKIP LOCKED).
ACCOUNT_DELETION_GRACE=720h
ACCOUNT_PURGE_INTERVAL=1h

# Events (consumer of poro.user.creator.activated). Sign-in works if the broker is down.
KAFKA_BROKERS=localhost:9092

# OTLP HTTP base URL; empty disables export
OTEL_EXPORTER_OTLP_ENDPOINT=
