# User service (NestJS). Copy to .env — never commit real values.

APP_ENV=dev
PORT=8082
LOG_LEVEL=debug

# Host port 5433 maps to the compose Postgres.
DATABASE_URL=postgresql://poro:poro_dev_password@localhost:5433/poro_user?sslmode=disable

# Optional in dev (in-memory rate limits). Required outside dev.
REDIS_URL=redis://localhost:6380/1

JWKS_URL=http://localhost:8081/.well-known/jwks.json
KAFKA_BROKERS=localhost:9092
# false: HTTP only, used by some tests
KAFKA_CONSUMER_ENABLED=true

# Object storage. S3_ENDPOINT is the server-to-server URL; S3_PUBLIC_ENDPOINT
# is the URL baked into presigned POST forms for the client.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=poro-avatars
S3_ACCESS_KEY_ID=poro_dev
S3_SECRET_ACCESS_KEY=poro_dev_secret
S3_FORCE_PATH_STYLE=true
AVATAR_PUBLIC_BASE_URL=http://localhost:9000/poro-avatars

# Exact origins only. Empty disables CORS (same-origin / native apps).
CORS_ORIGINS=
# Express trust proxy: false, a hop count, or a CIDR/IP
TRUST_PROXY=false

# OTLP HTTP base URL; empty disables export
OTEL_EXPORTER_OTLP_ENDPOINT=
